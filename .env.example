# ── Identity provider (Pocket ID) ─────────────────────────────────────────
# Base URL of your Pocket ID instance (no trailing slash)
IDENTITY_BASE_URL=https://id.example.com

# Admin API key from Pocket ID → Settings → API Keys
IDENTITY_API_KEY=your_pocketid_api_key

# OIDC client credentials (create an OIDC client in Pocket ID)
# Redirect URI must be: https://pocketboard.example.com/auth/callback
# Enable the "groups" scope / claim in the client settings
IDENTITY_CLIENT_ID=your_client_id
IDENTITY_CLIENT_SECRET=your_client_secret

# Provider backend — only "pocketid" is supported currently
# IDENTITY_PROVIDER=pocketid

# ── Mailbox provider (Migadu) ──────────────────────────────────────────────
# Admin email used for Migadu API auth
MAILBOX_API_USER=admin@example.com

# Migadu API key (account settings → API)
MAILBOX_API_KEY=your_migadu_api_key

# Domain for new mailboxes and for linked-account matching
MAILBOX_DOMAIN=example.com

# Provider backend — only "migadu" is supported currently
# MAILBOX_PROVIDER=migadu

# ── SMTP ───────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.migadu.com
# SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
# SMTP_FROM defaults to SMTP_USER if not set
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Organisation Onboarding

# ── Application ────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change_me_generate_a_random_secret

# Public URL of this app (used for OIDC redirect URI)
APP_BASE_URL=https://pocketboard.example.com

# ── Onboarding rate limiting ───────────────────────────────────────────────
# RATE_LIMIT_PER_USER_PER_DAY=10
# RATE_LIMIT_GLOBAL_PER_DAY=100

# ── Offboarding rate limiting ──────────────────────────────────────────────
# OFFBOARDING_RATE_LIMIT_PER_USER_PER_DAY=5
# OFFBOARDING_RATE_LIMIT_GLOBAL_PER_DAY=20

# ── Invite settings ────────────────────────────────────────────────────────
# How long the invite link stays valid (Go duration string: 24h, 168h, etc.)
# INVITE_TTL=168h

# How many times the invite link can be used (typically 1)
# INVITE_USAGE_LIMIT=1

# ── Group permission mappings ──────────────────────────────────────────────
# Format: caller_oidc_group=allowed_pocketid_group1,group2;other_caller=group3
# The caller groups are the OIDC groups the logged-in user belongs to.
# The target groups are PocketID group names the invitee will be added to.
GROUP_MAPPINGS=hr_onboarding=members,staff;hr_onboarding_privileged=members,staff,admins

# Groups pre-selected by default in the invite form (user can uncheck them).
# Must be a subset of groups reachable via GROUP_MAPPINGS.
# DEFAULT_SELECTED_GROUPS=members

# ── Offboarding ────────────────────────────────────────────────────────────
# Same format as GROUP_MAPPINGS: left=caller group, right=groups whose members
# they are allowed to offboard.
# OFFBOARDING_MAPPINGS=hr_onboarding=members,staff;it_admin=members,staff,admins

# Email address that receives the structured offboarding summary.
# Required to enable the "Send offboarding email" button.
# LINKED_ACCOUNTS_IT_EMAIL=it@example.com

# ── Mattermost (optional — enables linked-account discovery) ───────────────
# Base URL of your Mattermost instance (no trailing slash)
# MATTERMOST_URL=https://mattermost.example.com

# Bot token for fetching the Mattermost user list (read-only access is enough)
# MATTERMOST_TOKEN=your_mattermost_bot_token

# ── Webhook notifications (optional) ──────────────────────────────────────
# POST a notification to this URL on every audit log event.
# Payload format is Mattermost-compatible ({"text": "<markdown>", ...}).
# Mattermost: create an incoming webhook (Main Menu → Integrations → Incoming Webhooks)
# WEBHOOK_URL=https://mattermost.example.com/hooks/xxxxxxxxxxxxxxxxxxxx

# ── Access control (all default-deny) ─────────────────────────────────────
# Comma-separated PocketID group names that may view the audit log.
# AUDIT_LOG_GROUPS=ITAdmins,Admins

# Comma-separated PocketID group names that may clear the audit log.
# AUDIT_LOG_CLEAR_GROUPS=ITAdmins

# Comma-separated PocketID group names that may edit the invitation email template.
# EMAIL_TEMPLATE_GROUPS=ITAdmins

# Comma-separated PocketID group names that may view the organisation overview.
# ORG_OVERVIEW_GROUPS=ITAdmins,Management

# Comma-separated PocketID group names that may view the organisation audit (account mismatch page).
# ORG_AUDIT_GROUPS=ITAdmins

# ── Badge mappings (organisation overview) ─────────────────────────────────
# Map PocketID group names to short badge labels shown in the overview table.
# Format: PocketID Group Name=BADGE;Another Group=BADGE2
# BADGE_MAPPINGS=Group Management=MGR;Board Support=BOARD;IT Team=IT
