# ── Pocket ID ──────────────────────────────────────────────────────────────
# Base URL of your Pocket ID instance (no trailing slash)
POCKETID_BASE_URL=https://id.example.com

# Admin API key from Pocket ID → Settings → API Keys
POCKETID_API_KEY=your_pocketid_api_key

# OIDC client credentials (create an OIDC client in Pocket ID)
# Redirect URI must be: https://pocketboard.example.com/auth/callback
# Enable the "groups" scope / claim in the client settings
POCKETID_CLIENT_ID=your_client_id
POCKETID_CLIENT_SECRET=your_client_secret

# ── Migadu ─────────────────────────────────────────────────────────────────
# Admin email used for Migadu API auth
MIGADU_API_EMAIL=admin@example.com

# Migadu API key (account settings → API)
MIGADU_API_KEY=your_migadu_api_key

# Domain for new mailboxes
MIGADU_DOMAIN=example.com

# ── SMTP (Migadu) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.migadu.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Organisation Onboarding

# ── Application ────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change_me_generate_a_random_secret

# Public URL of this app (used for OIDC redirect URI)
APP_BASE_URL=https://pocketboard.example.com

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_USER_PER_DAY=10
RATE_LIMIT_GLOBAL_PER_DAY=100

# ── Invite settings ────────────────────────────────────────────────────────
# How long the invite link stays valid (Go duration string: 24h, 168h, etc.)
INVITE_TTL=168h

# How many times the invite link can be used (typically 1)
INVITE_USAGE_LIMIT=1

# ── Group permission mappings ──────────────────────────────────────────────
# Format: caller_oidc_group=allowed_pocketid_group1,group2;other_caller=group3,group4
# The caller groups are the OIDC groups the logged-in user belongs to.
# The target groups are PocketID group *names* the invitee will be added to.
#
# Example:
GROUP_MAPPINGS=hr_onboarding=members,staff;hr_onboarding_privileged=members,staff,admins

# Groups pre-selected by default in the invite form (user can uncheck them).
# Must be a subset of groups reachable via GROUP_MAPPINGS.
# DEFAULT_SELECTED_GROUPS=members

# ── Audit log access ───────────────────────────────────────────────────────
# Comma-separated PocketID group names that may view the audit log.
# If unset, no one can view it (default deny).
# AUDIT_LOG_GROUPS=ITAdmins,Admins

# Comma-separated PocketID group names that may clear the audit log.
# If unset, no one can clear it (default deny).
# AUDIT_LOG_CLEAR_GROUPS=ITAdmins

# ── Email template override ────────────────────────────────────────────────
# Placeholders: {to_name} {org_email} {invite_url} {group_list} {org_domain}
# ONBOARDING_TEMPLATE=Hello {to_name}, ...
